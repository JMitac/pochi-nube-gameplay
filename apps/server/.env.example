# Copia este archivo como .env para cambiar la configuración (lo lee `pnpm start`).

# Puerto del servidor de juego (HTTP + WebSocket)
PORT=2567

# Orígenes permitidos para la API HTTP cuando el cliente está en otro dominio (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Carpeta del cliente compilado. Si no se define, usa ../client/dist cuando existe.
# CLIENT_DIST_PATH=../client/dist
